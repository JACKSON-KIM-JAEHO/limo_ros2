<?xml version="1.0" ?>
<model>
  <name>Traffic Light</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>LIMO curriculum</name>
  </author>
  <description>
    Simple 3-light traffic pole (red/yellow/green). Each light's color/
    on-off state is controlled at runtime via the standard ROS-Gazebo
    "SetLightProperties" service (libgazebo_ros_properties.so, ships
    with ros-humble-gazebo-ros - no custom plugin needed):

      ros2 service call /set_light_properties gazebo_msgs/srv/SetLightProperties \
        "{light_name: 'traffic_light::pole::red_light', diffuse: {r: 1.0, g: 0.0, b: 0.0, a: 1.0}, attenuation_constant: 0.2}"

    (light_name must be "<model instance name>::<link name>::<light name>" -
    verified working in this repo's traffic_light_world.model, where the
    model is included with <name>traffic_light</name>.)

    Set a light's diffuse to near-black (0.05 0.05 0.05 1) to turn it
    "off" visually.
  </description>
</model>
