<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros/>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Track-Boden (siehe track_world.model) -->
    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ampel (siehe traffic_light_world.model) -->
    <include>
      <uri>model://traffic_light</uri>
      <name>traffic_light</name>
      <pose>0.5 -3.55 0 0 0 1.5708</pose>
    </include>

    <!-- Hindernisse auf der Strecke (siehe track_world_obstacles.model) -->
    <model name="track_obstacle_1">
      <static>true</static>
      <pose>0.4863 -3.2524 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>
    <model name="track_obstacle_2">
      <static>true</static>
      <pose>1.4863 -3.2524 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <!-- Zwei Parkzielzonen (siehe parking_world.model - Weltkoordinaten
         geschätzt, ggf. visuell nachjustieren). -->
    <model name="parking_target_1">
      <static>true</static>
      <pose>-0.6275 -0.1146 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 0.6</ambient><diffuse>0.1 0.3 0.9 0.6</diffuse></material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>
    <model name="parking_target_2">
      <static>true</static>
      <pose>-0.6275 1.1458 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 0.6</ambient><diffuse>0.9 0.6 0.1 0.6</diffuse></material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
