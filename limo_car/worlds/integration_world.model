<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros/>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Track-Boden (siehe track_world.model) -->
    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ampel (siehe traffic_light_world.model) -->
    <model name="traffic_light">
      <pose>0.962097 -3.800278 -0.739091 0 0 -1.787240</pose>
    <static>true</static>

    <link name="pole">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pole_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
        <material><script><name>Gazebo/DarkGrey</name></script></material>
      </visual>
      <collision name="pole_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
      </collision>

      <visual name="head_visual">
        <pose>0 0 1.14 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.48</size></box></geometry>
        <material><script><name>Gazebo/Black</name></script></material>
      </visual>

      <!-- Red -->
      <visual name="red_visual">
        <pose>0 -0.065 1.30 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.2 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <emissive>0.6 0 0 1</emissive>
        </material>
      </visual>
      <light name="red_light" type="point">
        <pose>0 -0.065 1.30 0 0 0</pose>
        <diffuse>1 0 0 1</diffuse>
        <specular>0.2 0 0 1</specular>
        <attenuation>
          <range>3.0</range>
          <constant>0.2</constant>
          <linear>0.3</linear>
          <quadratic>0.0</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>

      <!-- Yellow -->
      <visual name="yellow_visual">
        <pose>0 -0.065 1.14 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.2 0.2 0 1</ambient>
          <diffuse>0.05 0.05 0 1</diffuse>
          <emissive>0.05 0.05 0 1</emissive>
        </material>
      </visual>
      <light name="yellow_light" type="point">
        <pose>0 -0.065 1.14 0 0 0</pose>
        <diffuse>0.05 0.05 0 1</diffuse>
        <specular>0 0 0 1</specular>
        <attenuation>
          <range>3.0</range>
          <constant>0.2</constant>
          <linear>0.3</linear>
          <quadratic>0.0</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>

      <!-- Green -->
      <visual name="green_visual">
        <pose>0 -0.065 0.98 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0 0.2 0 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0.05 0.05 0.05 1</emissive>
        </material>
      </visual>
      <light name="green_light" type="point">
        <pose>0 -0.065 0.98 0 0 0</pose>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0 0 0 1</specular>
        <attenuation>
          <range>3.0</range>
          <constant>0.2</constant>
          <linear>0.3</linear>
          <quadratic>0.0</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>
    </link>
  </model>

    <!-- Hindernisse auf der Strecke (siehe track_world_obstacles.model) -->
    <model name="track_obstacle_1">
      <static>true</static>
      <pose>2.550257 -0.355558 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>
    <model name="track_obstacle_2">
      <static>true</static>
      <pose>-1.456148 0.411335 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <!-- Zwei Parkzielzonen (siehe parking_world.model - Weltkoordinaten
         geschätzt, ggf. visuell nachjustieren). -->
    <model name="parking_target_1">
      <static>true</static>
      <pose>-0.6275 -0.1146 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 0.6</ambient><diffuse>0.1 0.3 0.9 0.6</diffuse></material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>
    <model name="parking_target_2">
      <static>true</static>
      <pose>-0.6275 1.1458 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 0.6</ambient><diffuse>0.9 0.6 0.1 0.6</diffuse></material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
