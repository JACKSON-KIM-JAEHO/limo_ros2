<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <!-- Standard ROS-Gazebo plugin (ships with ros-humble-gazebo-ros,
         no custom compile needed) - exposes /set_light_properties etc.
         so a student node can change the traffic light's color at
         runtime. See models/traffic_light/model.config for the exact
         service call. -->
    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros/>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ampel neben der Spur, ~1m vor der Startlinie, standardmäßig rot
         an (die anderen zwei Lichter starten "aus" - siehe model.sdf). -->
    <include>
      <uri>model://traffic_light</uri>
      <name>traffic_light</name>
      <pose>0.5 -3.55 0 0 0 1.5708</pose>
    </include>

    <!-- Hindernisse auf der Strecke (bestätigte Positionen). -->
    <model name="track_obstacle_1">
      <static>true</static>
      <pose>0.4863 -3.2524 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>
    <model name="track_obstacle_2">
      <static>true</static>
      <pose>1.4863 -3.2524 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
