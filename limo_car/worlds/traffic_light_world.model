<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <!-- Standard ROS-Gazebo plugin (ships with ros-humble-gazebo-ros,
         no custom compile needed) - exposes /set_light_properties etc.
         so a student node can change the traffic light's color at
         runtime. See models/traffic_light/model.config for the exact
         service call. -->
    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros/>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ampel neben der Spur, ~1m vor der Startlinie, standardmäßig rot
         an (die anderen zwei Lichter starten "aus" - siehe model.sdf). -->
    <model name="traffic_light">
      <pose>0.962097 -3.800278 -0.739091 0 0 -1.787240</pose>
    <static>true</static>

    <!-- Pole + housing. Separate from the lens links below so the
         plugin can toggle each lens's own visual without touching
         these. -->
    <link name="pole">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pole_visual">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
        <material><script><name>Gazebo/DarkGrey</name></script></material>
      </visual>
      <collision name="pole_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.9</length></cylinder></geometry>
      </collision>
      <visual name="head_visual">
        <pose>0 0 1.14 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.48</size></box></geometry>
        <material><script><name>Gazebo/Black</name></script></material>
      </visual>
    </link>

    <!-- One link per lens (same pattern as the SKKUAutoLab traffic_ctrl
         model this curriculum's track texture came from): the
         traffic_light_plugin toggles a whole link's visuals by link
         name, so each color needs its own link, not just its own
         visual inside a shared link. -->
    <link name="red_light_link">
      <pose>0 -0.065 1.30 0 0 0</pose>
      <visual name="red_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.15 0 0 1</ambient>
          <diffuse>0.15 0 0 1</diffuse>
          <emissive>0.15 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <link name="yellow_light_link">
      <pose>0 -0.065 1.14 0 0 0</pose>
      <visual name="yellow_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.15 0.15 0 1</ambient>
          <diffuse>0.15 0.15 0 1</diffuse>
          <emissive>0.15 0.15 0 1</emissive>
        </material>
      </visual>
    </link>

    <link name="green_light_link">
      <pose>0 -0.065 0.98 0 0 0</pose>
      <visual name="green_visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0 0.15 0 1</ambient>
          <diffuse>0 0.15 0 1</diffuse>
          <emissive>0 0.15 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Runtime color control: publish std_msgs/String "red"|"yellow"|
         "green"|"off" on /traffic_light/color. See
         limo_plugin/src/traffic_light_plugin.cpp. -->
    <plugin name="traffic_light_plugin" filename="libtraffic_light_plugin.so">
      <topic>/traffic_light/color</topic>
      <initial_color>red</initial_color>
    </plugin>
  </model>

    <!-- Hindernisse auf der Strecke (bestätigte Positionen). -->
    <model name="track_obstacle_1">
      <static>true</static>
      <pose>2.550257 -0.355558 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>
    <model name="track_obstacle_2">
      <static>true</static>
      <pose>-1.456148 0.411335 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
