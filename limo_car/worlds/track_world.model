<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Race track ground plane. Texture/model from the SKKUAutoLab
         H-Mobility-Autonomous-Advanced-Course-Simulation repo (GPL-2.0),
         reused here as a vehicle-agnostic textured floor (not a Gazebo
         "model" with its own robot, just a material).

         Original plane was 53.83 x 40.473 m, sized for their real-scale
         cars (prius_hybrid chassis ~4.5m). LIMO is ~0.3m, about 1/14 that
         length, so the same plane is scaled down ~1/13.5 (aspect ratio
         kept at 4:3 ≈ original 1.33 ratio) to roughly match LIMO's scale. -->
    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
