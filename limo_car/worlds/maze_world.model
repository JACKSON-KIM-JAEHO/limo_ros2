<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros/>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ampel im Startfeld, innerhalb der Zelle (0,0) platziert, damit
         Wandlücken egal sind. -->
    <include>
      <uri>model://traffic_light</uri>
      <name>traffic_light</name>
      <pose>0.25 -0.25 0 0 0 0</pose>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Procedurally generated 10x10 maze (recursive backtracker, seed=7).
         Cell pitch 1.0m, wall thickness 0.06m, wall height 0.3m. Pitch
         chosen so LIMO can do a full forward-only U-turn (min turning
         diameter ~0.83m from the ackermann steer limit) in any corridor
         without reversing.
         9 dead ends. Solution path is 71 cells long (much more
         complex/winding than the earlier 6x6 version).
         Mission is "escape the maze": the East wall of the bottom-right
         corner cell (9,9) is left open (world x=9.5, y=-9.0) instead of
         a static internal goal marker, and a green flag sits 1m beyond
         that gap in open space (10.5, -9.0) - reaching it means the
         robot actually drove out of the maze.
         3 obstacles placed on the solution path for avoidance practice. -->

    <model name="wall_0">
      <static>true</static>
      <pose>0.500 0.000 0.150 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.060 1.060 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.060 1.060 0.3</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_1">
      <static>true</static>
      <pose>0.000 0.500 0.150 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.060 0.060 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.060 0.060 0.3</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_2">
      <static>true</static>
      <pose>-0.500 0.000 0.150 0 0 0.0</pose>
      <link name="link">
