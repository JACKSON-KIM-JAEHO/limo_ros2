<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Gleicher Track-Boden wie track_world.model (siehe dort für
         Herkunft/Skalierung). Die Textur zeigt bereits zwei Reihen
         Parkbuchten in der Mitte; die zwei Zielzonen unten sind eine
         ERSTE SCHÄTZUNG ihrer Weltkoordinaten (aus einem einzigen
         bekannten Kalibrierungspunkt - der bestätigten Startpose bei
         Pixel (77,222) = Welt (-0.5137,-3.2524) - grob zurückgerechnet).
         Nicht pixelgenau, bei Bedarf visuell nachjustieren. -->
    <model name="ground">
      <pose>0 0 0 0 0 1.57</pose>
      <static>1</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8.25 6.2</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://race_track/materials/scripts</uri>
              <uri>model://race_track/materials/textures</uri>
              <name>track</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zielzone 1 (vorwärts einparken üben): 0.6m x 0.4m, halbtransparent
         blau, keine Kollision (nur Markierung, blockiert nichts). -->
    <model name="parking_target_1">
      <static>true</static>
      <pose>-0.6275 -0.1146 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.9 0.6</ambient>
            <diffuse>0.1 0.3 0.9 0.6</diffuse>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <!-- Zielzone 2 (rückwärts einparken üben) -->
    <model name="parking_target_2">
      <static>true</static>
      <pose>-0.6275 1.1458 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.004</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.1 0.6</ambient>
            <diffuse>0.9 0.6 0.1 0.6</diffuse>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
  </world>
</sdf>
